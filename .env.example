# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rate_robot?schema=public"

# App Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here-at-least-32-chars"

# Encryption key for MGM session cookies (AES-256)
# Generate with: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY="your-32-byte-hex-key-here-64-chars-total"

# App URL (for magic links, connector callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email configuration (optional - for alerts)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
SMTP_FROM="noreply@yourdomain.com"

# Rate checking configuration
RATE_CHECK_INTERVAL_HOURS="6"
RATE_CHECK_CONCURRENCY="2"
RATE_CHECK_DELAY_MS="5000"

# Playwright configuration
PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_SLOW_MO="100"

# Feature flags
ENABLE_EMAIL_ALERTS="false"
ENABLE_LOCAL_CONNECTOR="true"
